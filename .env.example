# Server Port (Render injects this automatically)
PORT=3005

# Environment
NODE_ENV=production

# Node Version (Render blueprint)
NODE_VERSION=22

# Allowed Client Origin (Set to your Render URL, e.g. https://syncspace-watch-party.onrender.com)
# Leave blank or set to * for same-origin deployment
CLIENT_ORIGIN=

# SQLite Database Path (Uses local container storage: data/syncspace.db)
DB_PATH=data/syncspace.db
